{
  "syntax_pack_version": "0.3.0",
  "language": "arx",
  "status": "draft",
  "source_of_truth": "Canonical lexical source for editor tooling and lexer tables.",
  "file_extensions": [".x", ".arx"],

  "keywords": {
    "reserved": [
      "assert",
      "class",
      "const",
      "else",
      "except",
      "extern",
      "finally",
      "fn",
      "for",
      "if",
      "import",
      "in",
      "raise",
      "return",
      "then",
      "try",
      "var",
      "while"
    ],
    "contextual": ["as", "from", "type", "binary", "unary", "operator"]
  },

  "literals": {
    "keywords": ["true", "false", "none"],
    "booleans": {
      "true": true,
      "false": false
    },
    "none": {
      "token_value": null
    }
  },

  "comments": {
    "line": {
      "enabled": true,
      "delimiters": ["#"]
    },
    "block": {
      "enabled": false,
      "open": "",
      "close": "",
      "nesting": false
    }
  },

  "strings": {
    "supported": true,
    "quote_types": ["single", "double"],
    "triple_quotes": false,
    "raw_prefixes": [],
    "escapes": ["\\\\", "\\n", "\\r", "\\t", "\\\"", "\\'"],
    "interpolation": {
      "enabled": false,
      "start": "",
      "end": ""
    }
  },

  "docstrings": {
    "supported": true,
    "delimiter": "```",
    "token_kind": "docstring"
  },

  "numbers": {
    "formats": ["decimal_integer", "decimal_float"],
    "bases": [10],
    "underscores": { "allowed": false },
    "suffixes": [],
    "exponent": { "allowed": false, "forms": [] },
    "leading_dot_float": true,
    "trailing_dot_float": true,
    "multiple_dots": "invalid"
  },

  "identifiers": {
    "start": "Unicode letter or underscore",
    "continue": "Unicode alphanumeric or underscore",
    "pattern": "(?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*",
    "unicode_policy": "Current runtime behavior"
  },

  "whitespace": {
    "indentation_significant": true,
    "indent_unit": 2,
    "indent_unit_kind": "spaces",
    "tabs": "forbidden_or_error",
    "newlines_significant": true,
    "blank_lines": "ignored_for_indentation_transitions"
  },

  "operators": {
    "single_char": [
      "=",
      "<",
      ">",
      "+",
      "-",
      "*",
      "/",
      ".",
      ":",
      ",",
      ";",
      "@",
      "|",
      "!",
      "(",
      ")",
      "[",
      "]",
      "{",
      "}"
    ],
    "multi_char": ["==", "!=", "<=", ">=", "->", "&&", "||", "++", "--"],
    "word_operators": ["and", "or"],
    "assignment": ["="],
    "comparison": ["<", ">", "<=", ">=", "==", "!="],
    "arithmetic": ["+", "-", "*", "/"],
    "logical": ["&&", "||", "and", "or", "!"],
    "type_union": ["|"],
    "punctuation": ["@", ":", ",", ";", "."]
  },

  "structural_forms": {
    "annotations": {
      "start": "@[",
      "separator": ",",
      "end": "]",
      "modifiers": [
        "public",
        "private",
        "protected",
        "static",
        "constant",
        "mutable",
        "abstract",
        "extern"
      ]
    },
    "template_parameter_block": {
      "start": "@<",
      "separator": ",",
      "end": ">"
    },
    "explicit_template_call": {
      "uses_angle_brackets": true
    },
    "grouped_imports": {
      "supported": true,
      "requires_from": true,
      "allows_trailing_comma": true
    },
    "type_alias": {
      "form": "type Name = type",
      "supports_union_rhs": true,
      "top_level_only": true
    },
    "relative_imports": {
      "leading_dot_tokens": true
    },
    "dataframe_type": {
      "static_schema": "dataframe[name: type, ...]",
      "runtime_schema_parameter": "dataframe[...]",
      "runtime_schema_contexts": [
        "parameter",
        "return",
        "local",
        "type_alias",
        "cast"
      ]
    },
    "series_type": {
      "form": "series[type] or series[type | none]",
      "indexing": "series[index]",
      "null_operations": ["is_null(value)", "fill_null(value, replacement)"],
      "slicing": "series[start:stop:step]",
      "reductions": [
        "series_sum",
        "series_min",
        "series_max",
        "series_mean",
        "series_count",
        "series_any",
        "series_all"
      ]
    },
    "call_arguments": {
      "form": "callee(positional, name=value, ...)",
      "function_keywords": true,
      "method_keywords": true,
      "positional_after_keyword": false,
      "unpacking": false
    },
    "class_constructor": {
      "form": "Class(positional, name=value, ...)",
      "hooks": ["__init__", "__del__"],
      "reserved_method_pattern": "__name__",
      "allows_keyword_arguments": true
    },
    "file_constructor": {
      "class": "File",
      "factory": "open",
      "type_alias": "file",
      "opens_immediately": true,
      "allows_keyword_arguments": true
    },
    "dataframe_constructor": {
      "form": "dataframe({name: [literal, ...], ...})",
      "column_access": ["value.name", "value[\"name\"]"],
      "nullable_column_type": "dataframe[name: type | none]"
    }
  },

  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],

  "builtins": {
    "classes": ["File"],
    "types": [
      "i8",
      "i16",
      "i32",
      "i64",
      "u8",
      "u16",
      "u32",
      "u64",
      "int8",
      "int16",
      "int32",
      "int64",
      "f16",
      "f32",
      "f64",
      "float16",
      "float32",
      "float64",
      "bool",
      "boolean",
      "none",
      "file",
      "str",
      "string",
      "char",
      "datetime",
      "timestamp",
      "date",
      "time",
      "dataframe",
      "list",
      "series",
      "tensor",
      "nullable",
      "decimal128",
      "decimal256",
      "arrow_list",
      "large_list",
      "fixed_list",
      "dictionary",
      "binary",
      "large_binary",
      "large_string",
      "arrow_struct",
      "arrow_map"
    ],
    "functions": [
      "cast",
      "wrapping_cast",
      "wrapping_add",
      "wrapping_sub",
      "wrapping_mul",
      "dataframe",
      "date",
      "datetime",
      "isinstance",
      "is_null",
      "fill_null",
      "open",
      "print",
      "range",
      "time",
      "timestamp",
      "type",
      "series_sum",
      "series_min",
      "series_max",
      "series_mean",
      "series_count",
      "series_any",
      "series_all"
    ]
  }
}
